# Google AI Studio API key. Never commit the real value.
GEMINI_API_KEY=

# Default authentication is the current Gemini Developer API WebSocket flow.
GEMINI_AUTH_MODE=api_key_query
GEMINI_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent

# Verify every connecting user's Orbit subscription before opening Gemini.
ACCESS_CONTROL_ENABLED=true
SUBSCRIPTION_VERIFY_URL=https://manager.orbitkidslab.com/api/chatbot/verify-subscription
SUBSCRIPTION_VERIFY_TIMEOUT_SECONDS=10
PROXY_HOST=127.0.0.1
PROXY_PORT=8000
LOG_LEVEL=INFO

UPSTREAM_OPEN_TIMEOUT_SECONDS=15
UPSTREAM_PING_INTERVAL_SECONDS=20
UPSTREAM_PING_TIMEOUT_SECONDS=60
MAX_MESSAGE_BYTES=16777216

# ALSA playback device used by examples/voice_client.py.
AUDIO_OUTPUT_DEVICE=pipewire

# Alternative modes for future use:
# GEMINI_AUTH_MODE=access_token_query
# GEMINI_ACCESS_TOKEN=
# For ephemeral tokens, also set GEMINI_WS_URL to BidiGenerateContentConstrained.
# GEMINI_AUTH_MODE=bearer_header
